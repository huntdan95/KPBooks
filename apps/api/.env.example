# API server config — copy to .env (which is gitignored) and fill in.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Postgres connection. Local dev uses docker-compose; cloud uses Cloud SQL Auth Proxy.
DATABASE_URL=postgres://kpbooks:kpbooks@localhost:5432/kpbooks

# Firebase project (matches .firebaserc)
FIREBASE_PROJECT_ID=kpbooks-91c48

# Path to a Firebase Admin service-account JSON (only required outside Cloud Run).
# In Cloud Run, omit this and rely on workload identity instead.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=debug
