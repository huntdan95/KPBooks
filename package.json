{
  "name": "kpbooks",
  "private": true,
  "version": "0.0.0",
  "description": "KPBooks — self-hosted bookkeeping/accounting platform on Firebase + GCP",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check:i18n": "node scripts/check-i18n.mjs && node scripts/check-i18n-parity.mjs",
    "ship": "node scripts/deploy.mjs",
    "ship:web": "node scripts/deploy.mjs --web-only",
    "ship:api": "node scripts/deploy.mjs --api-only",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:db": "pnpm --filter @kpbooks/db test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @kpbooks/db migrate",
    "db:studio": "pnpm --filter @kpbooks/db studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,sql,yml,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "drizzle-kit": "^0.28.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
